[
  {
    "id": "e2e-test-tab",
    "type": "tab",
    "label": "Pulsar E2E Test",
    "disabled": false,
    "info": "Simple end-to-end test: Producer sends message, Consumer receives it"
  },
  {
    "id": "e2e-client",
    "type": "pulsar-client",
    "name": "Pulsar Docker",
    "authenticationNodeId": "",
    "serviceUrl": "pulsar://pulsar:6650",
    "serviceUrlTypedInput": "str",
    "operationTimeoutSeconds": "30",
    "ioThreads": "1",
    "messageListenerThreads": "1",
    "concurrentLookupRequest": "50000",
    "useTls": "false",
    "tlsTrustCertsFilePath": "",
    "tlsValidateHostname": "false",
    "tlsAllowInsecureConnection": "false",
    "statsIntervalInSeconds": "60",
    "listenerName": ""
  },
  {
    "id": "e2e-inject",
    "type": "inject",
    "z": "e2e-test-tab",
    "name": "Send Test Message",
    "props": [
      { "p": "payload" }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"test\": \"hello-pulsar\", \"timestamp\": $millis()}",
    "payloadType": "jsonata",
    "x": 150,
    "y": 100,
    "wires": [["e2e-producer"]]
  },
  {
    "id": "e2e-producer",
    "type": "pulsar-producer",
    "z": "e2e-test-tab",
    "name": "Producer",
    "clientNodeId": "e2e-client",
    "schemaNodeId": "",
    "topic": "e2e-test-topic",
    "topicTypedInput": "str",
    "producerName": "e2e-producer",
    "sendTimeoutMs": "",
    "initialSequenceId": "",
    "maxPendingMessages": "",
    "maxPendingMessagesAcrossPartitions": "",
    "blockIfQueueFull": "true",
    "messageRoutingMode": "Default",
    "hashingScheme": "Default",
    "compressionType": "Default",
    "batchingEnabled": "",
    "batchingMaxPublishDelayMs": "",
    "batchingMaxMessages": "",
    "properties": "{}",
    "publicKeyPath": "",
    "encryptionKey": "",
    "cryptoFailureAction": "Default",
    "chunkingEnabled": "",
    "accessMode": "Default",
    "x": 370,
    "y": 100,
    "wires": [["e2e-producer-status"]]
  },
  {
    "id": "e2e-producer-status",
    "type": "debug",
    "z": "e2e-test-tab",
