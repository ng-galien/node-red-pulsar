    "topic": "e2e-test-topic",
    "topicTypedInput": "str",
    "subscription": "e2e-subscription",
    "subscriptionType": "Shared",
    "subscriptionInitialPosition": "Latest",
    "ackTimeoutMs": "10000",
    "nAckRedeliverTimeoutMs": "60000",
    "receiverQueueSize": "100",
